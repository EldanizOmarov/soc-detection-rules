{
  "rule_id": "soc-hunt-new-process-0001",
  "name": "Hunt - Yeni proses (New Terms: Image)",
  "description": "Son 7 gunde gorulmeyen yeni proses (Image) - Bolme 11.3 Hunt B. Nadir proseslərin avtomatik aşkarlanması.",
  "type": "new_terms",
  "query": "event.code:1 AND winlog.channel:microsoft\\-windows\\-sysmon\\/operational",
  "language": "lucene",
  "new_terms_fields": ["winlog.event_data.Image"],
  "history_window_start": "now-7d",
  "index": ["soc-*"],
  "interval": "5m",
  "from": "now-10m",
  "to": "now",
  "enabled": true,
  "risk_score": 21,
  "severity": "low",
  "max_signals": 100,
  "author": ["Eldaniz Omarov"],
  "license": "MIT",
  "tags": ["SOC", "Hunt", "Elastic", "attack.execution", "T1059"],
  "false_positives": ["Yeni quraşdırılmış proqramlar və yeniləmələr"],
  "threat": [{"framework": "MITRE ATT&CK", "tactic": {"id": "TA0002", "name": "Execution", "reference": "https://attack.mitre.org/tactics/TA0002/"},
              "technique": [{"id": "T1059", "name": "Command and Scripting Interpreter", "reference": "https://attack.mitre.org/techniques/T1059/"}]}],
  "references": ["https://github.com/EldanizOmarov/soc-detection-rules/blob/main/elastic/native/hunt_new_process_new_terms.json"]
}
