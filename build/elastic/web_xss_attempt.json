{
  "rule_id": "d47c9b21-a58c-522e-b803-18af9d64059c",
  "name": "SIGMA - Web XSS Attempt",
  "description": "URL-də XSS payload (T1190).",
  "risk_score": 47,
  "severity": "medium",
  "type": "query",
  "query": "((url.original:(*\\<script* OR *onerror\\=* OR *onload\\=* OR *javascript\\:* OR *\\<svg* OR *\\<img*))) AND soc.source_type:web",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.initial_access",
    "T1190"
  ],
  "false_positives": [
    "Kod nümunəsi axtaran istifadəçilər"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1190",
          "name": "Exploit Public-Facing Application",
          "reference": "https://attack.mitre.org/techniques/T1190/"
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/web_xss_attempt.yml"
  ],
  "license": "MIT"
}