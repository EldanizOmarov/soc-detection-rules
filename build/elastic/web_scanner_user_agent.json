{
  "rule_id": "57b88874-9f6e-5bda-846e-5a113145b37c",
  "name": "SIGMA - Web Vulnerability Scanner User-Agent",
  "description": "sqlmap/nikto/masscan və s. User-Agent (T1595.002).",
  "risk_score": 47,
  "severity": "medium",
  "type": "query",
  "query": "((user_agent.original:(*sqlmap* OR *nikto* OR *masscan* OR *nmap* OR *dirbuster* OR *gobuster* OR *wpscan*))) AND soc.source_type:web",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.reconnaissance",
    "T1595.002"
  ],
  "false_positives": [
    "Daxili təhlükəsizlik skaneri"
  ],
  "threat": [
