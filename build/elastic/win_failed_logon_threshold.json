  "interval": "1m",
  "from": "now-420s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.credential_access",
    "T1110"
  ],
  "false_positives": [
    "Unudulmuş parol"
  ],
  "threat": [
