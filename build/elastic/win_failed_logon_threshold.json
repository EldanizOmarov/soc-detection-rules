          "reference": "https://attack.mitre.org/techniques/T1110/"
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/win_failed_logon_threshold.yml"
