{
  "rule_id": "c72fda86-f06d-52a8-8b99-c2689d0c1b6d",
  "name": "SIGMA - Certutil URL Download (Security 4688)",
  "description": "certutil ile URL-den yukleme; Security 4688 komanda setri (Sysmon bu prosesi yazmir).",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "query": "((winlog.event_data.NewProcessName:*\\\\certutil.exe AND winlog.event_data.CommandLine:(*\\-urlcache* OR *\\-verifyctl* OR *http\\:\\/\\/* OR *https\\:\\/\\/*) AND event.code:4688)) AND winlog.channel:security",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.command_and_control",
    "T1105"
  ],
  "false_positives": [
    "Sertifikat yenilənmələri"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command and Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1105",
          "name": "Ingress Tool Transfer",
          "reference": "https://attack.mitre.org/techniques/T1105/"
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/win4688_certutil_download.yml"
  ],
  "license": "MIT"
}