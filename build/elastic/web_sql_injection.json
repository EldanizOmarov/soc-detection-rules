{
  "rule_id": "be0ba144-ad32-59fb-a935-e9dec98adc8e",
  "name": "SIGMA - Web SQL Injection Attempt",
  "description": "URL-də SQL injection əlamətləri (T1190).",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "query": "((url.original:(*union\\ select* OR *union\\ all\\ select* OR *'\\ or\\ * OR *1\\=1* OR *drop\\ table* OR *information_schema* OR *sleep\\(* OR *\\-\\-*))) AND soc.source_type:web",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.initial_access",
    "T1190"
  ],
  "false_positives": [
    "Axtarış sorğusunda '--' simvolu"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1190",
          "name": "Exploit Public-Facing Application",
          "reference": "https://attack.mitre.org/techniques/T1190/"
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/web_sql_injection.yml"
  ],
  "license": "MIT"
}