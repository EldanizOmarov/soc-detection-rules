{
  "rule_id": "c4cad9a3-2efa-531b-908f-e6d4d74f56dd",
  "name": "SIGMA - Mshta Script or URL Execution (Security 4688)",
  "description": "mshta vbscript/javascript/URL (T1218.005); Security 4688.",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "query": "((winlog.event_data.NewProcessName:*\\\\mshta.exe AND winlog.event_data.CommandLine:(*vbscript\\:* OR *javascript\\:* OR *http\\:\\/\\/* OR *https\\:\\/\\/*) AND event.code:4688)) AND winlog.channel:security",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.defense_evasion",
    "T1218.005"
  ],
  "false_positives": [
    "Nadir"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1218",
          "name": "System Binary Proxy Execution",
          "reference": "https://attack.mitre.org/techniques/T1218/",
          "subtechnique": [
            {
              "id": "T1218.005",
              "name": "Mshta",
              "reference": "https://attack.mitre.org/techniques/T1218/005/"
            }
          ]
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/win4688_mshta_script.yml"
  ],
  "license": "MIT"
}