{
  "rule_id": "e1e24489-2fa4-520c-9df6-b5c9f27bf342",
  "name": "SIGMA - Certutil URL Download",
  "description": "certutil -urlcache ile yükləmə (Hunt-H4).",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "query": "((winlog.event_data.Image:*\\\\certutil.exe AND winlog.event_data.CommandLine:(*\\-urlcache* OR *\\-verifyctl* OR *http\\:\\/\\/* OR *https\\:\\/\\/*))) AND event.code:1 AND winlog.channel:microsoft\\-windows\\-sysmon\\/operational",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-360s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.command_and_control",
    "T1105"
  ],
  "false_positives": [
    "Sertifikat əməliyyatları"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command and Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1105",
          "name": "Ingress Tool Transfer",
          "reference": "https://attack.mitre.org/techniques/T1105/"
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/win_certutil_download.yml"
  ],
  "license": "MIT"
}