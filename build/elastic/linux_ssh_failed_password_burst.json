{
  "rule_id": "f158b57c-e6c8-5e3a-9b19-df879d087baa",
  "name": "SIGMA - Linux Auth - Failed Password Burst",
  "description": "5 dəqiqədə eyni IP-dən 5+ 'Failed password' (T1110.001).",
  "risk_score": 73,
  "severity": "high",
  "type": "threshold",
  "query": "((soc.msg:*failed\\ password*)) AND soc.source_type:auth AND _exists_:soc.msg",
  "language": "lucene",
  "index": [
    "soc-*"
  ],
  "interval": "1m",
  "from": "now-420s",
  "to": "now",
  "enabled": true,
  "max_signals": 100,
  "author": [
    "Eldaniz Omarov"
  ],
  "tags": [
    "SOC",
    "SIGMA",
    "Elastic",
    "attack.credential_access",
    "T1110.001"
  ],
  "false_positives": [
    "Unudulmuş parol"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1110",
          "name": "Brute Force",
          "reference": "https://attack.mitre.org/techniques/T1110/",
          "subtechnique": [
            {
              "id": "T1110.001",
              "name": "Password Guessing",
              "reference": "https://attack.mitre.org/techniques/T1110/001/"
            }
          ]
        }
      ]
    }
  ],
  "references": [
    "https://github.com/EldanizOmarov/soc-detection-rules/blob/main/sigma/elastic/linux_ssh_failed_password_burst.yml"
  ],
  "license": "MIT",
  "threshold": {
    "field": [
      "source.ip"
    ],
    "value": 5
  }
}